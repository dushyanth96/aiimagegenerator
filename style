@import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Inter, sans-serif;
}

:root {
    --color-primary: #5C56E1;
    --color-primary-dark: #5b21b6;
    --color-accent: #8B5CF6;
    --color-card: #FFFFFF;
    --color-input: #F1F1FF;
    --color-text: #09090E;
    --color-placeholder: #5C5A87;
    --color-border: #D4D4ED;
    --color-gradient: linear-gradient(135deg, #5C56E1, #8B5CF6);
}

body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 15px;
    color: var(--color-text);
    background: linear-gradient(#e9e9ff, #c8c7ff);
}

.container {
    width: 900px;
    padding: 32px;
    border-radius: 23px;
    position: relative;
    overflow: hidden;
    background: var(--color-card);
    box-shadow: 0px 16px 24px rgba(0, 0, 0, 0.1);
}

.container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: var(--color-gradient);
    border-radius: 23px;
    z-index: -1;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 18px;
}

.header .logo-wrapper .logo {
    height: 55px;
    width: 56px;
    display: flex;
    align-items: center;
    color: #fff;
    font-size: 1.35rem;
    flex-shrink: 0;
    justify-content: center;
    background: var(--color-primary);
    border-radius: 12px;
}

.header .logo-wrapper h1 {
    font-size: 1.9rem;
    font-weight: 700;
}

.header .theme-toggle {
    height: 43px;
    width: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--color-placeholder);
    border: var(--color-border);
    font-size: 1.05rem;
    background: var(--color-input);
    cursor: pointer;
}

.header .theme-toggle:hover {
    background: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
}

.main-content {
    margin: 35px 0 5px;
}

.main-content .prompt-container {
    width: 100%;
    margin-bottom: 20px;
    position: relative;
}

.prompt-container .prompt-input {
    width: 100%;
    line-height: 1.6;
    font-size: 1rem;
    color: var(--color-text);
    border-radius: 12px;
    background: var(--color-input);
    border: 1px solid var(--color-border);
    padding: 16px 20px;
    min-height: 120px;
    resize: vertical;
    transition: all 0.3s ease;
}

.prompt-container .prompt-input::placeholder {
    color: var(--color-placeholder);
    font-size: 1rem;
}

.prompt-container .prompt-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0px 0px 0px 3px rgba(92, 86, 225, 0.1);
}

.prompt-container .prompt-btn {
    position: absolute;
    right: 10px;
    bottom: 10px;
    height: 35px;
    width: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--color-placeholder);
    border: none;
    font-size: 1.05rem;
    background: var(--color-input);
    cursor: pointer;
    transform: all 0.3s ease;
}

.prompt-container .prompt-btn:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
}

.main-content .prompt-actions {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.1fr 1fr;
    gap: 15px;
}

.prompt-actions .select-wrapper {
    position: relative;
}

.prompt-actions .select-wrapper ::after {
    content: "\f078";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    color: var(--color-placeholder);
    position: absolute;
    top: 50%;
    right: 20px;
    padding-left: 7px;
    pointer-events: none;
    transform: translateY(-50%);
}

.prompt-actions :where(.custom-select, .generate-btn) {
    cursor: pointer;
    border-radius: 12px;
    background: var(--color-input);
    border: 1px solid var(--color-border);
    padding: 10px 15px;
    font-size: 1rem;
    color: var(--color-text);
    transition: all 0.3s ease;
}


.prompt-actions .custom-select {
    width: 100%;
    outline: none;
    height: 100%;
    appearance: none;
}







.main-content .gallery-grid {
    display: grid;
    grid-template-columns: repeat(autofill, minmax(180px, 1fr));
    gap: 15px;
    margin-top: 30px;
}

.gallery-grid .img-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 16px;
    background: var(--color-input);
    border: 1px solid var(--color-border);
}

.gallery-grid .img-card .result-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.gallery-grid .img-card .img-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 20px;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.3s ease;
}

.gallery-grid .img-card:hover .img-overlay {
    opacity: 1;
}

.gallery-grid .img-card .img-download-btn {
    height: 45px;
    width: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--color-placeholder);
    border: none;
    font-size: 1.05rem;
    background: var(--color-input);
    cursor: pointer;
    transform: all 0.3s ease;
}

.gallery-grid .img-card .img-download-btn:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
}